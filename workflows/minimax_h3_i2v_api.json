{
 "1": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
   "weight_dtype": "default"
  },
  "_meta": {
   "title": "MiniMax H3 fl2va (int8, 19.5 GB)"
  }
 },
 "2": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
   "type": "minimax",
   "device": "default"
  },
  "_meta": {
   "title": "Qwen3-VL-32B text encoder (nvfp4, 14.6 GB)"
  }
 },
 "3": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "minimax_h3_video_vae_fp16.safetensors"
  },
  "_meta": {
   "title": "Video VAE"
  }
 },
 "4": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
  },
  "_meta": {
   "title": "Audio VAE (32 kHz)"
  }
 },
 "15": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "polly_576.png"
  },
  "_meta": {
   "title": "Performer still (first frame, stretched to canvas)"
  }
 },
 "16": {
  "class_type": "LoadAudio",
  "inputs": {
   "audio": "seg_196s_5p5s.wav"
  },
  "_meta": {
   "title": "Song segment (anchored soundtrack)"
  }
 },
 "5": {
  "class_type": "MiniMaxH3ImageToVideo",
  "inputs": {
   "clip": ["2", 0],
   "vae": ["3", 0],
   "first_frame": ["15", 0],
   "prompt": "A chrome figure plays a drum kit in a dark studio, performance synced to the music. The scene opens on the figure from the first frame, who sits at a drum kit and plays in time with every beat of the soundtrack; every hit lands on the beat. Audio: the music track only, no dialogue.",
   "width": 480,
   "height": 832,
   "length": 124
  },
  "_meta": {
   "title": "H3 image-to-video conditioning + empty AV latent (length snaps to 17k+5 frames at 24 fps)"
  }
 },
 "17": {
  "class_type": "MiniMaxH3AddGuide",
  "inputs": {
   "positive": ["5", 0],
   "latent": ["5", 1],
   "audio_vae": ["4", 0],
   "audio": ["16", 0],
   "frame_idx": 0
  },
  "_meta": {
   "title": "Anchor the soundtrack at frame 0 (audio latent re-injected every step; cropped to the video length)"
  }
 },
 "6": {
  "class_type": "BasicGuider",
  "inputs": {
   "model": ["1", 0],
   "conditioning": ["17", 0]
  },
  "_meta": {
   "title": "Guider (no CFG, as in the template)"
  }
 },
 "7": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "res_multistep"
  },
  "_meta": {
   "title": "Sampler"
  }
 },
 "8": {
  "class_type": "BasicScheduler",
  "inputs": {
   "model": ["1", 0],
   "scheduler": "simple",
   "steps": 20,
   "denoise": 1.0
  },
  "_meta": {
   "title": "Scheduler (20 steps base model; 8 or 4 with the turbo LoRAs, not installed)"
  }
 },
 "9": {
  "class_type": "RandomNoise",
  "inputs": {
   "noise_seed": 7
  },
  "_meta": {
   "title": "Noise"
  }
 },
 "10": {
  "class_type": "SamplerCustomAdvanced",
  "inputs": {
   "noise": ["9", 0],
   "guider": ["6", 0],
   "sampler": ["7", 0],
   "sigmas": ["8", 0],
   "latent_image": ["5", 1]
  },
  "_meta": {
   "title": "Sample the joint video+audio latent"
  }
 },
 "11": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": ["10", 0],
   "vae": ["3", 0]
  },
  "_meta": {
   "title": "Decode video"
  }
 },
 "12": {
  "class_type": "VAEDecodeAudio",
  "inputs": {
   "samples": ["10", 0],
   "vae": ["4", 0]
  },
  "_meta": {
   "title": "Decode audio (should reproduce the anchored segment)"
  }
 },
 "13": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": ["11", 0],
   "fps": 24.0,
   "audio": ["12", 0],
   "bit_depth": 8
  },
  "_meta": {
   "title": "Mux at 24 fps"
  }
 },
 "14": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": ["13", 0],
   "filename_prefix": "video/xenoform_h3",
   "format": "auto",
   "codec": "auto"
  },
  "_meta": {
   "title": "Save mp4"
  }
 }
}
