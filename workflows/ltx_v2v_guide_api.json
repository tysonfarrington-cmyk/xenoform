{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "ltx-video-2b-v0.9.5.safetensors"
    },
    "_meta": {"title": "Load LTX checkpoint"}
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "t5xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "ltxv"
    },
    "_meta": {"title": "LTX text encoder"}
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "glossy liquid chrome biotech organism, dark studio",
      "clip": ["2", 0]
    },
    "_meta": {"title": "Positive prompt"}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "text, watermark, human, flicker, low detail",
      "clip": ["2", 0]
    },
    "_meta": {"title": "Negative prompt"}
  },
  "5": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": ["3", 0],
      "negative": ["4", 0],
      "frame_rate": 24.0
    },
    "_meta": {"title": "LTXV frame rate"}
  },
  "6": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "xenoform_chunk.mp4"
    },
    "_meta": {"title": "Base-form chunk"}
  },
  "7": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["6", 0]
    },
    "_meta": {"title": "Frames"}
  },
  "8": {
    "class_type": "LTXVPreprocess",
    "inputs": {
      "image": ["7", 0],
      "img_compression": 18
    },
    "_meta": {"title": "LTXV preprocess"}
  },
  "9": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": 512,
      "height": 320,
      "length": 49,
      "batch_size": 1
    },
    "_meta": {"title": "Empty LTX latent"}
  },
  "10": {
    "class_type": "LTXVAddGuide",
    "inputs": {
      "positive": ["5", 0],
      "negative": ["5", 1],
      "vae": ["1", 2],
      "latent": ["9", 0],
      "image": ["8", 0],
      "frame_idx": 0,
      "strength": 0.75
    },
    "_meta": {"title": "Guide the whole chunk"}
  },
  "11": {
    "class_type": "LTXVScheduler",
    "inputs": {
      "steps": 20,
      "max_shift": 2.05,
      "base_shift": 0.95,
      "stretch": true,
      "terminal": 0.1,
      "latent": ["10", 2]
    },
    "_meta": {"title": "LTX sigmas"}
  },
  "12": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    },
    "_meta": {"title": "Sampler"}
  },
  "13": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 7
    },
    "_meta": {"title": "Seed"}
  },
  "20": {
    "class_type": "ModelSamplingLTXV",
    "inputs": {
      "model": ["1", 0],
      "max_shift": 2.05,
      "base_shift": 0.95,
      "latent": ["10", 2]
    },
    "_meta": {"title": "LTX sampling shift"}
  },
  "14": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["20", 0],
      "positive": ["10", 0],
      "negative": ["10", 1],
      "cfg": 3.0
    },
    "_meta": {"title": "CFG"}
  },
  "15": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["13", 0],
      "guider": ["14", 0],
      "sampler": ["12", 0],
      "sigmas": ["11", 0],
      "latent_image": ["10", 2]
    },
    "_meta": {"title": "Sample"}
  },
  "16": {
    "class_type": "LTXVCropGuides",
    "inputs": {
      "positive": ["10", 0],
      "negative": ["10", 1],
      "latent": ["15", 0]
    },
    "_meta": {"title": "Drop guide frames"}
  },
  "17": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["16", 2],
      "vae": ["1", 2]
    },
    "_meta": {"title": "Decode"}
  },
  "18": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["17", 0],
      "fps": 24.0
    },
    "_meta": {"title": "Create video"}
  },
  "19": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["18", 0],
      "filename_prefix": "xenoform/chunk",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {"title": "Save video"}
  }
}
